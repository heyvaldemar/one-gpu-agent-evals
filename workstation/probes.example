# What the environment must and must not reach, for workstation/isolation_check.py.
# The real file lives only inside the environment and is never published: it
# names addresses. This example uses documentation addresses (RFC 5737).
#
# data   PATH                 the series' data directory (must be writable)
# allow  HOST PORT [series]   must connect while preparing; in a series too if marked
# deny   HOST PORT            must be refused or time out, in both phases
data /srv/series
# Preparing: the hosts a series fetches from, through the host's allowlist.
allow 192.0.2.10 3128
# A series: only what the host lends it.
allow 127.0.0.1 22 series
# Never: the host's own services, the local network, the outside directly.
deny 192.0.2.1 80
deny 198.51.100.7 443
deny 1.1.1.1 443
